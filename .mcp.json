{
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "${ATLASSIAN_MCP_URL:-https://mcp.atlassian.com/v2/mcp}"
    },
    "github": {
      "type": "http",
      "url": "${GITHUB_MCP_URL:-https://api.githubcopilot.com/mcp/}",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
