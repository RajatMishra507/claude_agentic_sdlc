# Copy to .env (gitignored). orchestrator.py loads it; agents are blocked from reading it.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Override MCP endpoints if your organisation uses different URLs.
# ATLASSIAN_MCP_URL=
# GITHUB_MCP_URL=
# Path to the claude binary. If unset the engine tries `claude`, then `codemie-claude` (how CodeMie launches Claude Code).
# SDLC_CLAUDE_BIN=
# Per-phase agent timeout in seconds (default 1800) and optional spend cap per phase.
# SDLC_PHASE_TIMEOUT=1800
# SDLC_MAX_BUDGET_USD=
